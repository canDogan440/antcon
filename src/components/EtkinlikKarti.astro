---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Ikon from '@components/Ikon.astro';
import { tarihBicimle, gecmisteMi } from '@lib/icerik';
import { yedekKapak, gorselBul } from '@lib/gorseller';

interface Props {
  etkinlik: CollectionEntry<'etkinlikler'>;
}

const { etkinlik } = Astro.props;
const { yil, baslik, slogan, baslangic, tarihMetni, durum, mekan, ozet, kapak, kapakAlt, istatistikler, oneCikanlar } =
  etkinlik.data;

const gecmisMi = gecmisteMi(etkinlik.data);

// Etkinlik kaydinda kapak secilmemisse o yilin galerisindeki ilk fotograf kullanilir.
const yedek = await yedekKapak(yil);
const kapakSrc = gorselBul(kapak) ?? yedek?.src;
const kapakMetni = kapakAlt ?? yedek?.alt ?? `AntCon ${yil} etkinliğinden bir kare`;

const DURUM_ROZETI = gecmisMi
  ? { metin: 'Tamamlandı', sinif: 'bg-mist text-ink-soft' }
  : durum === 'iptal'
    ? { metin: 'İptal edildi', sinif: 'bg-mist text-ink-soft' }
    : durum === 'planlama'
      ? // Marka mavisi + beyaz = 8.13:1; secondary-blue uzerinde beyaz metin
        // kucuk puntoda 4.5:1 esigini gecmiyordu.
        { metin: 'Planlama Aşamasında', sinif: 'bg-main-blue text-white' }
      : { metin: 'Yaklaşan Etkinlik', sinif: 'bg-orange-deep text-white' };
---

<article class="kart kart-hover flex h-full flex-col overflow-hidden">
  <div class="relative aspect-[16/9] overflow-hidden bg-blue-deep">
    {
      kapakSrc ? (
        <Image
          src={kapakSrc}
          alt={kapakMetni}
          width={960}
          widths={[400, 640, 960]}
          sizes="(min-width: 1024px) 420px, 92vw"
          format="webp"
          quality={75}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      ) : (
        <div
          class="flex h-full w-full items-center justify-center bg-gradient-to-br from-main-blue to-blue-darker"
          aria-hidden="true"
        >
          <span class="font-display text-6xl font-bold text-white/25">{yil}</span>
        </div>
      )
    }

    <span
      class:list={[
        'absolute top-3 left-3 rounded-full px-3 py-1 text-xs font-bold',
        DURUM_ROZETI.sinif,
      ]}
    >
      {DURUM_ROZETI.metin}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <p class="etiket">{yil}</p>
    <h3 class="mt-2 font-display text-xl font-bold text-blue-deep">{baslik}</h3>
    {slogan && <p class="mt-1 text-sm font-semibold text-orange-deep">{slogan}</p>}

    <dl class="mt-4 space-y-2 text-sm text-ink-soft">
      <div class="flex items-center gap-2">
        <dt class="sr-yalniz">Tarih</dt>
        <Ikon ad="takvim" sinif="w-4 h-4 text-main-blue shrink-0" />
        <dd>
          {
            baslangic ? (
              <time datetime={baslangic.toISOString()}>
                {tarihMetni || tarihBicimle(baslangic)}
              </time>
            ) : (
              tarihMetni
            )
          }
        </dd>
      </div>
      <div class="flex items-center gap-2">
        <dt class="sr-yalniz">Mekân</dt>
        <Ikon ad="konum" sinif="w-4 h-4 text-main-blue shrink-0" />
        <dd>{mekan.ad ? `${mekan.ad}, ${mekan.sehir}` : mekan.sehir}</dd>
      </div>
    </dl>

    <p class="mt-4 flex-1 text-sm leading-relaxed text-ink-soft">{ozet}</p>

    {
      istatistikler.length > 0 && (
        <dl class="mt-5 grid grid-cols-3 gap-3 border-t border-line pt-5">
          {istatistikler.slice(0, 3).map((istatistik) => (
            <div class="text-center">
              <dt class="sr-yalniz">{istatistik.etiket}</dt>
              <dd>
                <span class="block font-display text-xl font-bold text-orange-deep">
                  {istatistik.deger}
                </span>
                <span class="mt-0.5 block text-[0.7rem] font-semibold tracking-wide text-ink-soft uppercase">
                  {istatistik.etiket}
                </span>
              </dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      oneCikanlar.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-1.5">
          {oneCikanlar.slice(0, 4).map((oge) => (
            <li class="rounded-full bg-mist px-2.5 py-1 text-xs font-semibold text-blue-deep">
              {oge}
            </li>
          ))}
        </ul>
      )
    }

    <a
      href={`/gecmis-etkinlikler/${yil}`}
      class="mt-6 inline-flex items-center gap-2 font-display text-sm font-bold text-orange-deep transition-colors hover:text-orange-darker"
    >
      {yil} detaylarını gör
      <Ikon ad="ok_sag" sinif="w-4 h-4" />
    </a>
  </div>
</article>
