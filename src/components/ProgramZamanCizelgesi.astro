---
import type { CollectionEntry } from 'astro:content';
import Ikon from '@components/Ikon.astro';
import { OTURUM_TURU_ETIKETLERI, type ProgramGunu } from '@lib/icerik';

interface Props {
  gunler: ProgramGunu[];
  /** İsim çözümlemesi için konuşmacı listesi */
  konusmacilar?: CollectionEntry<'konusmacilar'>[];
}

const { gunler, konusmacilar = [] } = Astro.props;

const konusmaciAdi = (kimlik: string) =>
  konusmacilar.find((k) => k.id === kimlik)?.data.ad ?? kimlik;

/** Oturum türüne göre rozet rengi. Turuncu yalnızca vurgulanması gereken türlerde. */
const TUR_STILI: Record<string, string> = {
  acilis: 'bg-orange-deep text-white',
  kapanis: 'bg-orange-deep text-white',
  konusma: 'bg-main-blue/15 text-blue-deep',
  panel: 'bg-main-blue/15 text-blue-deep',
  atolye: 'bg-secondary-blue/25 text-blue-deep',
  gosteri: 'bg-secondary-orange/25 text-orange-deep',
  turnuva: 'bg-secondary-orange/25 text-orange-deep',
  mola: 'bg-mist text-ink-soft',
};
---

{
  gunler.map((gun) => (
    <section class="mt-12 first:mt-0" aria-labelledby={`gun-${gun.gun}`}>
      <h2
        id={`gun-${gun.gun}`}
        class="flex items-center gap-3 font-display text-xl font-bold text-blue-deep md:text-2xl"
      >
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-deep text-white">
          <Ikon ad="takvim" sinif="w-5 h-5" />
        </span>
        {gun.etiket}
      </h2>

      <ol class="relative mt-8 space-y-4 border-l-2 border-line pl-5 sm:pl-8">
        {gun.oturumlar.map((oturum) => {
          const { baslik, aciklama, baslangic, bitis, salon, tur } = oturum.data;
          const molaMi = tur === 'mola';

          return (
            <li class="relative">
              {/* Zaman çizelgesi noktası */}
              <span
                class:list={[
                  'absolute top-6 -left-[1.6rem] h-3.5 w-3.5 rounded-full border-2 border-white sm:-left-[2.35rem]',
                  molaMi ? 'bg-secondary-blue' : 'bg-main-orange',
                ]}
                aria-hidden="true"
              />

              <article
                class:list={[
                  'kart p-4 sm:p-5',
                  molaMi ? 'border-dashed bg-mist shadow-none' : 'kart-hover',
                ]}
              >
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="flex items-center gap-2 font-display text-sm font-bold text-orange-deep tabular-nums">
                      <Ikon ad="saat" sinif="w-4 h-4" />
                      <time datetime={`${gun.gun}T${baslangic}:00+03:00`}>{baslangic}</time>
                      <span aria-hidden="true">–</span>
                      <time datetime={`${gun.gun}T${bitis}:00+03:00`}>{bitis}</time>
                    </p>

                    <h3
                      class:list={[
                        'mt-2 font-display font-bold',
                        molaMi ? 'text-base text-ink-soft' : 'text-lg text-blue-deep',
                      ]}
                    >
                      {baslik}
                    </h3>
                  </div>

                  <span
                    class:list={[
                      'shrink-0 rounded-full px-3 py-1 text-xs font-bold',
                      TUR_STILI[tur] ?? 'bg-mist text-ink-soft',
                    ]}
                  >
                    {OTURUM_TURU_ETIKETLERI[tur] ?? tur}
                  </span>
                </div>

                {aciklama && <p class="mt-2.5 text-sm leading-relaxed text-ink-soft">{aciklama}</p>}

                <div class="mt-3.5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-soft">
                  <span class="inline-flex items-center gap-1.5">
                    <Ikon ad="konum" sinif="w-4 h-4 text-main-blue" />
                    {salon}
                  </span>

                  {oturum.data.konusmacilar.length > 0 && (
                    <span class="inline-flex items-center gap-1.5">
                      <Ikon ad="mikrofon" sinif="w-4 h-4 text-main-blue" />
                      <span class="font-semibold text-ink">
                        {oturum.data.konusmacilar.map(konusmaciAdi).join(', ')}
                      </span>
                    </span>
                  )}
                </div>
              </article>
            </li>
          );
        })}
      </ol>
    </section>
  ))
}
