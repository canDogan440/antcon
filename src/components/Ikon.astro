---
/**
 * Tek dosyada toplanmis inline SVG ikon seti.
 * Harici ikon kutuphanesi yuklemedigimiz icin sayfaya ek JS/CSS gelmez.
 *
 * Kullanim:  <Ikon ad="bilet" sinif="w-5 h-5" />
 * Dekoratif ikonlar aria-hidden olur; anlamli olanlara etiket verin:
 *            <Ikon ad="konum" etiket="Konum" />
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'svg'>, 'class'> {
  ad: keyof typeof YOLLAR;
  sinif?: string;
  /** Verilirse ikon ekran okuyucuya bu metinle duyurulur. */
  etiket?: string;
  /** Dolgu tipi ikonlar (sosyal medya) icin true. */
  dolgu?: boolean;
}

const YOLLAR = {
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  kapat: '<path d="M6 6l12 12M18 6L6 18"/>',
  takvim:
    '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/>',
  saat: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  konum:
    '<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/>',
  bilet:
    '<path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h13A2.5 2.5 0 0 1 21 8.5v1a2.5 2.5 0 0 0 0 5v1a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 15.5v-1a2.5 2.5 0 0 0 0-5z"/><path d="M14 6v12"/>',
  ok_sag: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  ok_sol: '<path d="M19 12H5M11 18l-6-6 6-6"/>',
  asagi: '<path d="M6 9l6 6 6-6"/>',
  yukari: '<path d="M18 15l-6-6-6 6"/>',
  arti: '<path d="M12 5v14M5 12h14"/>',
  posta: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  telefon:
    '<path d="M6.5 3h3l1.5 4.5-2 1.4a12.5 12.5 0 0 0 6.1 6.1l1.4-2L21 14.5v3a2.5 2.5 0 0 1-2.7 2.5A16.8 16.8 0 0 1 4 5.7 2.5 2.5 0 0 1 6.5 3z"/>',
  onay: '<path d="m4.5 12.5 5 5 10-11"/>',
  yildiz:
    '<path d="m12 3.5 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17.5l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>',
  kisiler:
    '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16.5 5.4a3.2 3.2 0 0 1 0 5.2M18 20a6.4 6.4 0 0 0-2.2-4.8"/>',
  mikrofon:
    '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3M9 21h6"/>',
  kivilcim:
    '<path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M18.5 15.5 19 17l1.5.5-1.5.5-.5 1.5-.5-1.5L16.5 17l1.5-.5z"/>',
  oyun:
    '<rect x="2.5" y="7" width="19" height="10" rx="4"/><path d="M7 10.5v3M5.5 12h3M15.5 11.5h.01M18 13.5h.01"/>',
  kupa:
    '<path d="M8 4h8v5a4 4 0 0 1-8 0z"/><path d="M8 5H5.5v1.5A3.5 3.5 0 0 0 9 10M16 5h2.5v1.5A3.5 3.5 0 0 1 15 10M10 13h4l.5 4h-5z"/><path d="M8 20h8"/>',
  kalkan: '<path d="M12 3 5 6v5.5c0 4.3 3 8 7 9.5 4-1.5 7-5.2 7-9.5V6z"/><path d="m9 12 2 2 4-4"/>',
  indir: '<path d="M12 3v12M7.5 10.5 12 15l4.5-4.5M4 20h16"/>',
  kure:
    '<circle cx="12" cy="12" r="9"/><path d="M3.5 9h17M3.5 15h17M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/>',
  // --- Sosyal medya (dolgu tipi) ---
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/>',
  x: '<path d="M4 4h3.7l4.5 6 5.2-6H21l-6.9 7.9L21.4 20h-3.7l-4.9-6.5L7 20H4.3l7.3-8.4z" fill="currentColor" stroke="none"/>',
  linkedin:
    '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7.2 10v7M7.2 7.2v.01M11 17v-4a2 2 0 0 1 4 0v4"/>',
  youtube:
    '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10.5 9.5 5 2.5-5 2.5z"/>',
  discord:
    '<path d="M8.5 8.2A12 12 0 0 1 12 7.8c1.2 0 2.4.1 3.5.4M7 17.2c-1.7-2.6-2-6-1.2-8.9A13 13 0 0 1 9 6.6L9.7 8M17 17.2c1.7-2.6 2-6 1.2-8.9A13 13 0 0 0 15 6.6L14.3 8M7 17.2c1.4 1 3.2 1.5 5 1.5s3.6-.5 5-1.5"/><path d="M9.8 13.2h.01M14.2 13.2h.01"/>',
  tiktok:
    '<path d="M14 4v9.2a3.3 3.3 0 1 1-2.8-3.3"/><path d="M14 4c.4 2.2 2 3.7 4.2 3.9"/>',
  github:
    '<path d="M9 19c-4 1.2-4-2.2-5.5-2.7M15 21v-3.3a2.9 2.9 0 0 0-.8-2.2c2.7-.3 5.5-1.3 5.5-5.9a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.5 2.8 5.5 3.1 5.5 3.1a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.6c0 4.5 2.8 5.6 5.5 5.9a2.9 2.9 0 0 0-.8 2.2V21"/>',
} as const;

const { ad, sinif = 'w-5 h-5', etiket, dolgu = false, ...kalan } = Astro.props;
const yol = YOLLAR[ad];
---

<svg
  class={sinif}
  viewBox="0 0 24 24"
  fill={dolgu ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={etiket ? undefined : 'true'}
  role={etiket ? 'img' : undefined}
  aria-label={etiket}
  {...kalan}
  set:html={yol}
/>
