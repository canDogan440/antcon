---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  sponsorlar: CollectionEntry<'sponsorlar'>[];
  /** Sütun sayısı sınıfı - farklı seviyeler için farklı yoğunluk */
  sutunlar?: string;
  /** Logo kutusunun yüksekliği */
  boyut?: 'buyuk' | 'orta' | 'kucuk';
  /** Koyu mavi zeminde mi gösteriliyor? */
  koyuZemin?: boolean;
}

const {
  sponsorlar,
  sutunlar = 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4',
  boyut = 'orta',
  koyuZemin = false,
} = Astro.props;

const YUKSEKLIK = {
  buyuk: 'h-24 md:h-28',
  orta: 'h-16 md:h-20',
  kucuk: 'h-12 md:h-14',
} as const;
---

<ul class:list={['grid gap-4', sutunlar]}>
  {
    sponsorlar.map((sponsor) => {
      const { ad, logo, url, aciklama } = sponsor.data;

      const icerik = (
        <>
          {logo ? (
            <Image
              src={logo}
              alt={`${ad} logosu`}
              width={480}
              widths={[180, 320, 480]}
              sizes="(min-width: 1024px) 260px, 40vw"
              format="webp"
              quality={85}
              loading="lazy"
              class:list={[
                'w-auto max-w-full object-contain transition duration-300',
                YUKSEKLIK[boyut],
                koyuZemin ? '' : 'grayscale opacity-75 group-hover:grayscale-0 group-hover:opacity-100',
              ]}
            />
          ) : (
            // Logo yüklenmemiş sponsorlar için okunaklı metin yer tutucu
            <span
              class:list={[
                'flex items-center justify-center px-3 text-center font-display font-bold',
                YUKSEKLIK[boyut],
                koyuZemin ? 'text-white/90' : 'text-blue-deep',
                boyut === 'buyuk' ? 'text-xl' : 'text-base',
              ]}
            >
              {ad}
            </span>
          )}
          {/* Logo görselken adı ekran okuyucuya ayrıca duyuruyoruz.
              Metin yer tutucu zaten adı okuyor, tekrar etmiyoruz. */}
          {logo ? (
            <span class="sr-yalniz">{aciklama ? `${ad} - ${aciklama}` : ad}</span>
          ) : (
            aciklama && <span class="sr-yalniz">{aciklama}</span>
          )}
        </>
      );

      return (
        <li>
          {url ? (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class:list={[
                'group flex h-full items-center justify-center rounded-xl border p-4 transition-colors',
                koyuZemin
                  ? 'border-white/15 bg-white/5 hover:border-main-orange hover:bg-white/10'
                  : 'border-line bg-white hover:border-secondary-blue hover:shadow-card',
              ]}
              aria-label={`${ad} web sitesi (yeni sekmede açılır)`}
            >
              {icerik}
            </a>
          ) : (
            <div
              class:list={[
                'group flex h-full items-center justify-center rounded-xl border p-4',
                koyuZemin ? 'border-white/15 bg-white/5' : 'border-line bg-white',
              ]}
            >
              {icerik}
            </div>
          )}
        </li>
      );
    })
  }
</ul>
