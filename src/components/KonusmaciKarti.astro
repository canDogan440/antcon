---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Ikon from '@components/Ikon.astro';
import { gorselBul } from '@lib/gorseller';

interface Props {
  konusmaci: CollectionEntry<'konusmacilar'>;
  /** Ana sayfadaki önizleme için daha kompakt görünüm */
  kompakt?: boolean;
}

const { konusmaci, kompakt = false } = Astro.props;
const { ad, unvan, kurum, kullaniciAdi, kisaBio, foto, fotoAlt, sosyal, etiketler } =
  konusmaci.data;
const fotoSrc = gorselBul(foto);

/**
 * Alt satir: unvan varsa onu (kurum ile birlikte) gosteririz.
 * Unvan bilinmiyorsa uydurmak yerine @kullanici adini gosteriyoruz.
 */
const altSatir = unvan
  ? [unvan, kurum].filter(Boolean).join(' · ')
  : kurum
    ? [kurum, kullaniciAdi && `@${kullaniciAdi}`].filter(Boolean).join(' · ')
    : kullaniciAdi
      ? `@${kullaniciAdi}`
      : '';

// Fotoğrafı olmayan konuşmacılar için baş harflerden oluşan yer tutucu.
// Tek kelimelik adlarda (örn. kullanıcı adı) ilk iki harfi alıyoruz.
const adParcalari = ad.split(/[\s_.-]+/).filter(Boolean);
const basHarfler = (
  adParcalari.length > 1
    ? adParcalari
        .slice(0, 2)
        .map((parca) => parca[0])
        .join('')
    : ad.slice(0, 2)
).toLocaleUpperCase('tr-TR');

const sosyalListesi = [
  { anahtar: 'x', ad: 'X', url: sosyal.x },
  { anahtar: 'linkedin', ad: 'LinkedIn', url: sosyal.linkedin },
  { anahtar: 'instagram', ad: 'Instagram', url: sosyal.instagram },
  { anahtar: 'youtube', ad: 'YouTube', url: sosyal.youtube },
  { anahtar: 'github', ad: 'GitHub', url: sosyal.github },
  { anahtar: 'kure', ad: 'Web sitesi', url: sosyal.web },
].filter((s): s is { anahtar: string; ad: string; url: string } => Boolean(s.url));
---

<article class="kart kart-hover group flex h-full flex-col overflow-hidden">
  <!-- Fotoğraf -->
  <div class="relative aspect-[4/5] overflow-hidden bg-mist">
    {
      fotoSrc ? (
        <Image
          src={fotoSrc}
          alt={fotoAlt ?? `${ad} portre fotoğrafı`}
          width={600}
          widths={[240, 400, 600]}
          sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 90vw"
          format="webp"
          quality={78}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div
          class="flex h-full w-full items-center justify-center bg-gradient-to-br from-main-blue to-blue-darker"
          aria-hidden="true"
        >
          <span class="font-display text-5xl font-bold text-white/90">{basHarfler}</span>
        </div>
      )
    }

    {
      etiketler.length > 0 && (
        <ul class="absolute top-3 left-3 flex flex-wrap gap-1.5">
          {etiketler.slice(0, 2).map((etiket) => (
            <li class="rounded-full bg-blue-darker/85 px-2.5 py-1 text-[0.7rem] font-semibold text-white backdrop-blur-sm">
              {etiket}
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <!-- Bilgiler -->
  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-lg font-bold text-blue-deep">{ad}</h3>
    {altSatir && <p class="mt-1 text-sm font-semibold text-orange-deep">{altSatir}</p>}

    {
      !kompakt && kisaBio && (
        <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{kisaBio}</p>
      )
    }

    {
      sosyalListesi.length > 0 && (
        <ul class="mt-auto flex flex-wrap gap-1.5 border-t border-line pt-4 [&:not(:first-child)]:mt-4">
          {sosyalListesi.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-mist text-blue-deep transition-colors hover:bg-orange-deep hover:text-white"
                aria-label={`${ad} - ${s.ad} (yeni sekmede açılır)`}
              >
                <Ikon ad={s.anahtar as any} sinif="w-4 h-4" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
