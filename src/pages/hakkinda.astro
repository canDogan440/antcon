---
import BaseLayout from '@layouts/BaseLayout.astro';
import SayfaBasligi from '@components/SayfaBasligi.astro';
import Carousel from '@components/Carousel.astro';
import Ikon from '@components/Ikon.astro';
import BolumBasligi from '@components/BolumBasligi.astro';
import { carouselGorselleri } from '@lib/gorseller';
import { kirintiSemasi } from '@lib/schema';
import { sayfaMetinleri, sayfaGovdesi } from '@lib/sayfa';
import {
  ETKINLIK,
  AKTIF_YIL,
  SON_ETKINLIK_YILI,
  ANA_CTA,
  BILET_SATISI,
} from '@config/site';

const metinler = await sayfaMetinleri('hakkindaSayfasi');
const hikaye = await sayfaGovdesi('hakkindaSayfasi');
const { durumKutusu, degerler, yolculuk, galeri } = metinler;

const gorseller = await carouselGorselleri(5, SON_ETKINLIK_YILI);
---

<BaseLayout
  baslik="Hakkında"
  aciklama={metinler.seoAciklama}
  yapilandirilmisVeri={[kirintiSemasi([{ ad: 'Hakkında', href: '/hakkinda' }])]}
>
  <SayfaBasligi
    etiket={metinler.etiket}
    baslik={metinler.baslik}
    aciklama={metinler.aciklama}
    kirintilar={[{ ad: 'Hakkında', href: '/hakkinda' }]}
  />

  <!-- Hikâye -->
  <section class="bolum bg-white">
    <div class="kapsayici">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="metin-akisi lg:col-span-7" set:html={hikaye} />

        <!-- Durum kutusu: tarih, mekân ve bilet satırları ayarlardan otomatik gelir -->
        <aside class="lg:col-span-5">
          <div class="kart sticky top-24 p-6 md:p-7">
            <h2 class="font-display text-lg font-bold text-blue-deep">{durumKutusu.baslik}</h2>

            <dl class="mt-5 space-y-4 text-sm">
              <div class="flex gap-3">
                <dt class="sr-yalniz">Sıradaki etkinlik</dt>
                <Ikon ad="takvim" sinif="w-5 h-5 shrink-0 text-orange-deep" />
                <dd>
                  <strong class="block text-blue-deep">AntCon {AKTIF_YIL}</strong>
                  <span class="text-ink-soft">{ETKINLIK.tarihMetni}</span>
                </dd>
              </div>
              <div class="flex gap-3">
                <dt class="sr-yalniz">Mekân</dt>
                <Ikon ad="konum" sinif="w-5 h-5 shrink-0 text-orange-deep" />
                <dd>
                  <strong class="block text-blue-deep">
                    {ETKINLIK.mekan.ad || ETKINLIK.mekan.sehir}
                  </strong>
                  <span class="text-ink-soft">
                    {ETKINLIK.mekan.ad ? ETKINLIK.mekan.sehir : durumKutusu.mekanNotu}
                  </span>
                </dd>
              </div>
              <div class="flex gap-3">
                <dt class="sr-yalniz">Bilet durumu</dt>
                <Ikon ad="bilet" sinif="w-5 h-5 shrink-0 text-orange-deep" />
                <dd>
                  <strong class="block text-blue-deep">{BILET_SATISI.durum.baslik}</strong>
                  <span class="text-ink-soft">{BILET_SATISI.durum.aciklama}</span>
                </dd>
              </div>
              <div class="flex gap-3">
                <dt class="sr-yalniz">Geçmiş etkinlik</dt>
                <Ikon ad="onay" sinif="w-5 h-5 shrink-0 text-orange-deep" />
                <dd>
                  <strong class="block text-blue-deep">AntCon {SON_ETKINLIK_YILI}</strong>
                  <span class="text-ink-soft">{durumKutusu.gecmisEtkinlikNotu}</span>
                </dd>
              </div>
            </dl>

            <a href={ANA_CTA.href} class="btn btn-turuncu mt-7 w-full">
              <Ikon ad={ANA_CTA.ikon} sinif="w-5 h-5" />
              {ANA_CTA.metin}
            </a>
            <a
              href={`/gecmis-etkinlikler/${SON_ETKINLIK_YILI}`}
              class="btn btn-cizgi mt-3 w-full"
            >
              {durumKutusu.arsivButonu}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Değerler -->
  <section class="bolum bg-mist">
    <div class="kapsayici">
      <BolumBasligi etiket={degerler.etiket} baslik={degerler.baslik} hizalama="orta" />
      <ul class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          degerler.maddeler.map((deger) => (
            <li class="kart kart-hover flex gap-4 p-6">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-main-orange/12 text-orange-deep">
                <Ikon ad={deger.ikon} sinif="w-6 h-6" />
              </span>
              <div>
                <h3 class="font-display text-lg font-bold text-blue-deep">{deger.baslik}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">{deger.metin}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Zaman çizelgesi -->
  <section class="bolum bg-blue-deep">
    <div class="kapsayici">
      <BolumBasligi etiket={yolculuk.etiket} baslik={yolculuk.baslik} koyuZemin={true} hizalama="orta" />

      <ol class="mx-auto mt-12 max-w-3xl space-y-6 border-l-2 border-white/20 pl-6 sm:pl-10">
        {
          yolculuk.adimlar.map((adim) => (
            <li class="relative">
              <span
                class:list={[
                  'absolute top-6 -left-[1.9rem] flex h-4 w-4 items-center justify-center rounded-full border-2 border-blue-deep sm:-left-[2.9rem]',
                  adim.durum === 'suan'
                    ? 'bg-white ring-4 ring-main-orange/40'
                    : adim.durum === 'planli'
                      ? 'bg-white/40'
                      : 'bg-main-orange',
                ]}
                aria-hidden="true"
              />
              <div
                class:list={[
                  'rounded-xl border p-5',
                  adim.durum === 'suan'
                    ? 'border-main-orange/60 bg-main-orange/10'
                    : 'border-white/12 bg-white/5',
                ]}
              >
                <p class="flex flex-wrap items-center gap-2 font-display text-sm font-bold tracking-[0.12em] text-orange-glow uppercase">
                  {adim.tarih}
                  {adim.durum === 'tamam' && (
                    <span class="inline-flex items-center gap-1 rounded-full bg-white/10 px-2 py-0.5 text-[0.65rem] tracking-normal text-white/80 normal-case">
                      <Ikon ad="onay" sinif="w-3 h-3" />
                      Tamamlandı
                    </span>
                  )}
                </p>
                <h3 class="mt-2 font-display text-lg font-bold text-white">{adim.baslik}</h3>
                <p class="mt-2 text-sm leading-relaxed text-white/75">{adim.metin}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Galeri -->
  <section class="bolum bg-white">
    <div class="kapsayici">
      <BolumBasligi
        etiket={galeri.etiket}
        baslik={galeri.baslik}
        aciklama={galeri.aciklama}
        hizalama="orta"
      />
      <div class="mt-10">
        <Carousel
          gorseller={gorseller}
          sure={6000}
          etiket={`AntCon ${SON_ETKINLIK_YILI} etkinlik alanı fotoğrafları`}
        />
      </div>
    </div>
  </section>
</BaseLayout>
