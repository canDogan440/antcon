---
import BaseLayout from '@layouts/BaseLayout.astro';
import SayfaBasligi from '@components/SayfaBasligi.astro';
import BiletKarti from '@components/BiletKarti.astro';
import GeriSayim from '@components/GeriSayim.astro';
import Ikon from '@components/Ikon.astro';
import BolumBasligi from '@components/BolumBasligi.astro';
import SssAkordiyon from '@components/SssAkordiyon.astro';
import { biletleriGetir, sssGetir, etkinlikGetir } from '@lib/icerik';
import { etkinlikSemasi, kirintiSemasi } from '@lib/schema';
import { sayfaMetinleri } from '@lib/sayfa';
import {
  AKTIF_YIL,
  ETKINLIK,
  SON_ETKINLIK_YILI,
  TARIH_BELLI,
  BILET_SATISI,
  ANA_CTA,
} from '@config/site';

const metinler = await sayfaMetinleri('biletlerSayfasi');
const { kapaliKutu, acikKutu, surec, kapsam, sss } = metinler;

const biletler = await biletleriGetir(AKTIF_YIL);
const tumSss = await sssGetir(AKTIF_YIL);
const biletSorulari = tumSss.filter((s) => s.data.kategori === 'bilet');

/**
 * Satis durumu tamamen paneldeki "Bilet Satışı Açık mı?" anahtarina bagli.
 * Acikken bilet tipi kartlari varsa onlar, yoksa (biletler dis bir sitede
 * satiliyorsa) satis linkini tasiyan tek bir kutu gosterilir.
 */
const satisAcik = BILET_SATISI.acik;
const kartlarVar = biletler.length > 0;
const hariciLink = BILET_SATISI.hariciUrl.startsWith('http');

const siradakiEtkinlik = await etkinlikGetir(AKTIF_YIL);
const eventSemasi = siradakiEtkinlik
  ? etkinlikSemasi(
      siradakiEtkinlik.data,
      satisAcik
        ? biletler.map((b) => ({
            ad: b.data.ad,
            fiyat: b.data.fiyat,
            paraBirimi: b.data.paraBirimi,
            url: b.data.satinAlUrl ?? (BILET_SATISI.hariciUrl || '/biletler'),
            durum: b.data.durum,
          }))
        : [],
    )
  : null;
---

<BaseLayout
  baslik="Biletler"
  aciklama={satisAcik ? metinler.seoAciklamaAcik : metinler.seoAciklamaKapali}
  yapilandirilmisVeri={[
    kirintiSemasi([{ ad: 'Biletler', href: '/biletler' }]),
    ...(eventSemasi ? [eventSemasi] : []),
  ]}
  yapiskanCta={false}
>
  <SayfaBasligi
    etiket={metinler.etiket}
    baslik={satisAcik ? metinler.acikBaslik : metinler.kapaliBaslik}
    aciklama={satisAcik ? metinler.acikAciklama : metinler.kapaliAciklama}
    kirintilar={[{ ad: 'Biletler', href: '/biletler' }]}
  />

  <!-- Geri sayım şeridi - yalnızca tarih açıklandığında -->
  {
    TARIH_BELLI && (
      <section class="bg-blue-darker py-8">
        <div class="kapsayici flex flex-col items-center gap-6 md:flex-row md:justify-between">
          <div class="text-center md:text-left">
            <p class="etiket etiket-acik">{metinler.geriSayimEtiketi}</p>
            <p class="mt-1 font-display text-lg font-bold text-white">
              {ETKINLIK.tarihMetni}
              {ETKINLIK.gunMetni && `, ${ETKINLIK.gunMetni}`}
            </p>
          </div>
          <GeriSayim hedef={ETKINLIK.baslangic} bitis={ETKINLIK.bitis} sinif="max-w-md" />
        </div>
      </section>
    )
  }

  <!-- Bilet kartları / satış linki veya "yakında" durumu -->
  <section class="bolum bg-white" data-bilet-durumu={satisAcik ? 'acik' : 'kapali'}>
    <div class="kapsayici">
      <h2 class="sr-yalniz">AntCon {AKTIF_YIL} bilet durumu</h2>

      {
        satisAcik && kartlarVar ? (
          <>
            <ul class="grid items-stretch gap-6 pt-4 sm:grid-cols-2 lg:grid-cols-4">
              {biletler.map((bilet) => (
                <li>
                  <BiletKarti bilet={bilet} />
                </li>
              ))}
            </ul>
            {BILET_SATISI.fiyatNotu && (
              <p class="mt-8 text-center text-sm text-ink-soft">{BILET_SATISI.fiyatNotu}</p>
            )}
          </>
        ) : satisAcik ? (
          <div class="kart mx-auto max-w-3xl border-2 border-main-orange p-8 text-center md:p-12">
            <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-main-orange/12 text-orange-deep">
              <Ikon ad="bilet" sinif="w-8 h-8" />
            </span>
            <h3 class="mt-5 font-display text-2xl font-bold text-blue-deep">{acikKutu.baslik}</h3>
            <p class="mx-auto mt-4 max-w-xl leading-relaxed text-ink-soft">
              {BILET_SATISI.bilgiMetni}
            </p>
            <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
              <a
                href={hariciLink ? BILET_SATISI.hariciUrl : '/iletisim'}
                class="btn btn-turuncu btn-buyuk"
                {...(hariciLink ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <Ikon ad="bilet" sinif="w-5 h-5" />
                {ANA_CTA.metin}
              </a>
            </div>
            {BILET_SATISI.fiyatNotu && (
              <p class="mt-6 text-sm text-ink-soft">{BILET_SATISI.fiyatNotu}</p>
            )}
          </div>
        ) : (
          <div class="kart mx-auto max-w-3xl p-8 text-center md:p-12">
            <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-main-orange/12 text-orange-deep">
              <Ikon ad="bilet" sinif="w-8 h-8" />
            </span>

            <h3 class="mt-5 font-display text-2xl font-bold text-blue-deep">
              {kapaliKutu.baslik}
            </h3>
            <p class="mx-auto mt-4 max-w-xl leading-relaxed text-ink-soft">
              {BILET_SATISI.bilgiMetni}
            </p>

            <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
              <a href="/iletisim" class="btn btn-turuncu">
                <Ikon ad="posta" sinif="w-5 h-5" />
                {kapaliKutu.birinciButon}
              </a>
              <a href={`/gecmis-etkinlikler/${SON_ETKINLIK_YILI}`} class="btn btn-cizgi">
                {kapaliKutu.ikinciButon}
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- Satış süreci -->
  {
    !satisAcik && (
      <section class="bolum bg-mist">
        <div class="kapsayici">
          <BolumBasligi
            etiket={surec.etiket}
            baslik={surec.baslik}
            aciklama={surec.aciklama}
            hizalama="orta"
          />

          <ol class="mt-12 grid gap-5 md:grid-cols-3">
            {surec.adimlar.map((adim) => (
              <li class="kart kart-hover p-6">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-main-orange/12 text-orange-deep">
                  <Ikon ad={adim.ikon} sinif="w-6 h-6" />
                </span>
                <h3 class="mt-4 font-display text-lg font-bold text-blue-deep">{adim.baslik}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">{adim.metin}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <!-- Bilete dahil olanlar -->
  {
    kapsam.maddeler.length > 0 && (
      <section class:list={['bolum', satisAcik ? 'bg-mist' : 'bg-white']}>
        <div class="kapsayici">
          <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
            <div class="lg:col-span-5">
              <BolumBasligi
                etiket={kapsam.etiket}
                baslik={satisAcik ? kapsam.acikBaslik : kapsam.kapaliBaslik}
                aciklama={satisAcik ? kapsam.acikAciklama : kapsam.kapaliAciklama}
              />
            </div>
            <div class="lg:col-span-7">
              <ul class="grid gap-3 sm:grid-cols-2">
                {kapsam.maddeler.map((oge) => (
                  <li class="kart flex items-start gap-3 p-4">
                    <Ikon ad="onay" sinif="w-5 h-5 mt-0.5 shrink-0 text-orange-deep" />
                    <span class="text-sm font-medium text-ink">{oge}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Bilet SSS -->
  {
    biletSorulari.length > 0 && (
      <section class:list={['bolum', satisAcik ? 'bg-white' : 'bg-mist']}>
        <div class="kapsayici max-w-3xl">
          <BolumBasligi etiket={sss.etiket} baslik={sss.baslik} hizalama="orta" />
          <div class="mt-10">
            <SssAkordiyon sorular={biletSorulari} grup="bilet-sss" />
          </div>
          <p class="mt-8 text-center">
            <a href="/sss" class="btn btn-cizgi btn-kucuk">
              {sss.buton}
              <Ikon ad="ok_sag" sinif="w-4 h-4" />
            </a>
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>
