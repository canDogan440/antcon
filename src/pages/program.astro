---
import BaseLayout from '@layouts/BaseLayout.astro';
import SayfaBasligi from '@components/SayfaBasligi.astro';
import ProgramZamanCizelgesi from '@components/ProgramZamanCizelgesi.astro';
import Ikon from '@components/Ikon.astro';
import BolumBasligi from '@components/BolumBasligi.astro';
import {
  programiGetir,
  konusmacilariGetir,
  OTURUM_TURU_ETIKETLERI,
} from '@lib/icerik';
import { kirintiSemasi } from '@lib/schema';
import { ETKINLIK, AKTIF_YIL, SON_ETKINLIK_YILI, TARIH_BELLI } from '@config/site';

const gunler = await programiGetir(AKTIF_YIL);
const konusmacilar = await konusmacilariGetir(AKTIF_YIL);

const tumOturumlar = gunler.flatMap((gun) => gun.oturumlar);
const salonlar = [...new Set(tumOturumlar.map((o) => o.data.salon))];
const turler = [...new Set(tumOturumlar.map((o) => o.data.tur))].filter((t) => t !== 'mola');

// Program henüz yoksa geçen yılın programını özet olarak gösteriyoruz.
const gecenProgram = await programiGetir(SON_ETKINLIK_YILI);
const gecenOturumlar = gecenProgram
  .flatMap((gun) => gun.oturumlar)
  .filter((o) => o.data.tur !== 'mola');
---

<BaseLayout
  baslik="Program"
  aciklama={
    tumOturumlar.length > 0
      ? `AntCon ${AKTIF_YIL} saat saat program: konuşmalar, paneller, atölyeler, e-spor turnuvası ve cosplay yarışması.`
      : `AntCon ${AKTIF_YIL} programı hazırlanıyor. AntCon ${SON_ETKINLIK_YILI}'nın program akışını inceleyebilir, yeni program açıklandığında haberdar olmak için duyuru listesine katılabilirsiniz.`
  }
  yapilandirilmisVeri={[kirintiSemasi([{ ad: 'Program', href: '/program' }])]}
>
  <SayfaBasligi
    etiket="Program"
    baslik={tumOturumlar.length > 0 ? `AntCon ${AKTIF_YIL} akışı` : 'Program hazırlanıyor'}
    aciklama={
      tumOturumlar.length > 0
        ? `${ETKINLIK.tarihMetni} · ${ETKINLIK.mekan.sehir}. Program etkinlik gününe kadar güncellenmeye devam edecek.`
        : `AntCon ${AKTIF_YIL} için sahne programı ve atölye takvimi üzerinde çalışıyoruz. Tarih kesinleştikten sonra oturum oturum burada yayınlanacak.`
    }
    kirintilar={[{ ad: 'Program', href: '/program' }]}
  />

  {
    tumOturumlar.length > 0 ? (
      /* ---------- Program yayında ---------- */
      <section class="bolum bg-white">
        <div class="kapsayici">
          <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
            <aside class="lg:order-last lg:col-span-4">
              <div class="kart sticky top-24 p-6">
                <h2 class="font-display text-lg font-bold text-blue-deep">Bir bakışta</h2>

                <dl class="mt-5 space-y-4 text-sm">
                  <div>
                    <dt class="font-semibold text-blue-deep">Toplam oturum</dt>
                    <dd class="mt-1 text-ink-soft">{tumOturumlar.length} program başlığı</dd>
                  </div>
                  <div>
                    <dt class="font-semibold text-blue-deep">Salonlar</dt>
                    <dd class="mt-1.5 flex flex-wrap gap-1.5">
                      {salonlar.map((salon) => (
                        <span class="rounded-full bg-mist px-2.5 py-1 text-xs font-semibold text-blue-deep">
                          {salon}
                        </span>
                      ))}
                    </dd>
                  </div>
                  <div>
                    <dt class="font-semibold text-blue-deep">Oturum türleri</dt>
                    <dd class="mt-1.5 flex flex-wrap gap-1.5">
                      {turler.map((tur) => (
                        <span class="rounded-full bg-main-orange/12 px-2.5 py-1 text-xs font-semibold text-orange-deep">
                          {OTURUM_TURU_ETIKETLERI[tur] ?? tur}
                        </span>
                      ))}
                    </dd>
                  </div>
                </dl>

                <a href={TARIH_BELLI ? '/biletler' : '/iletisim'} class="btn btn-turuncu mt-6 w-full">
                  <Ikon ad={TARIH_BELLI ? 'bilet' : 'posta'} sinif="w-5 h-5" />
                  {TARIH_BELLI ? 'Bilet Al' : 'Haberdar Ol'}
                </a>
              </div>
            </aside>

            <div class="lg:col-span-8">
              <ProgramZamanCizelgesi gunler={gunler} konusmacilar={konusmacilar} />
            </div>
          </div>
        </div>
      </section>
    ) : (
      /* ---------- Program henüz yok ---------- */
      <>
        <section class="bolum bg-white">
          <div class="kapsayici">
            <div class="kart mx-auto max-w-3xl p-8 text-center md:p-12">
              <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-main-orange/12 text-orange-deep">
                <Ikon ad="mikrofon" sinif="w-8 h-8" />
              </span>

              <h2 class="mt-5 font-display text-2xl font-bold text-blue-deep">
                AntCon {AKTIF_YIL} programı üzerinde çalışıyoruz
              </h2>
              <p class="mx-auto mt-4 max-w-xl leading-relaxed text-ink-soft">
                Sahne programı, atölyeler ve turnuva takvimi tarih kesinleştikten sonra
                netleşecek. Konuşmacı ve atölye başvuruları da o dönemde açılacak.
              </p>

              <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
                <a href="/iletisim" class="btn btn-turuncu">
                  <Ikon ad="posta" sinif="w-5 h-5" />
                  Duyuru Listesine Katıl
                </a>
                <a href={`/gecmis-etkinlikler/${SON_ETKINLIK_YILI}`} class="btn btn-cizgi">
                  {SON_ETKINLIK_YILI} programını gör
                </a>
              </div>
            </div>
          </div>
        </section>

        {/* Geçen yılın programından örnek akış */}
        {gecenOturumlar.length > 0 && (
          <section class="bolum bg-mist">
            <div class="kapsayici">
              <BolumBasligi
                etiket={`AntCon ${SON_ETKINLIK_YILI}`}
                baslik="Geçen yıl sahnede neler vardı?"
                aciklama={`İlk AntCon'un program akışı ${AKTIF_YIL} için de bir fikir veriyor. Tam listeyi arşiv sayfasında bulabilirsiniz.`}
                hizalama="orta"
              />

              <ol class="mx-auto mt-10 max-w-3xl space-y-3">
                {gecenOturumlar.map((oturum) => (
                  <li class="kart flex flex-wrap items-center gap-x-5 gap-y-2 p-4 sm:flex-nowrap">
                    <time
                      datetime={`${oturum.data.gun}T${oturum.data.baslangic}:00+03:00`}
                      class="w-16 shrink-0 font-display text-base font-bold text-orange-deep tabular-nums"
                    >
                      {oturum.data.baslangic}
                    </time>
                    <div class="min-w-0 flex-1">
                      <h3 class="font-display text-base font-bold text-blue-deep">
                        {oturum.data.baslik}
                      </h3>
                      <p class="mt-0.5 text-sm text-ink-soft">{oturum.data.salon}</p>
                    </div>
                    <span class="shrink-0 rounded-full bg-mist px-3 py-1 text-xs font-bold text-ink-soft">
                      {OTURUM_TURU_ETIKETLERI[oturum.data.tur] ?? oturum.data.tur}
                    </span>
                  </li>
                ))}
              </ol>

              <p class="mt-8 text-center">
                <a href={`/gecmis-etkinlikler/${SON_ETKINLIK_YILI}`} class="btn btn-cizgi btn-kucuk">
                  {SON_ETKINLIK_YILI} arşivini aç
                  <Ikon ad="ok_sag" sinif="w-4 h-4" />
                </a>
              </p>
            </div>
          </section>
        )}
      </>
    )
  }
</BaseLayout>
