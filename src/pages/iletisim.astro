---
import BaseLayout from '@layouts/BaseLayout.astro';
import SayfaBasligi from '@components/SayfaBasligi.astro';
import IletisimFormu from '@components/IletisimFormu.astro';
import Ikon from '@components/Ikon.astro';
import { kirintiSemasi } from '@lib/schema';
import { sayfaMetinleri } from '@lib/sayfa';
import { ETKINLIK, ILETISIM, SOSYAL, SON_ETKINLIK_YILI } from '@config/site';

const metinler = await sayfaMetinleri('iletisimSayfasi');
const { form, mekan, sosyal } = metinler;

/** Mekan kesinlestiginde adres bloğu ve harita otomatik olarak görünür hale gelir. */
const mekanBelli = ETKINLIK.mekan.ad !== '';

/**
 * Iletisim kanallari. Telefon numarasi tanimliysa listeye otomatik eklenir;
 * bos oldugu surece gorunmez.
 */
const KANALLAR = [
  {
    ikon: 'posta' as const,
    baslik: 'E-posta',
    deger: ILETISIM.email,
    href: `mailto:${ILETISIM.email}`,
  },
  ...(ILETISIM.telefon
    ? [
        {
          ikon: 'telefon' as const,
          baslik: 'Telefon',
          deger: ILETISIM.telefon,
          href: `tel:${ILETISIM.telefonHref}`,
        },
      ]
    : []),
];
---

<BaseLayout
  baslik="İletişim"
  aciklama={metinler.seoAciklama}
  yapilandirilmisVeri={[kirintiSemasi([{ ad: 'İletişim', href: '/iletisim' }])]}
>
  <SayfaBasligi
    etiket={metinler.etiket}
    baslik={metinler.baslik}
    aciklama={metinler.aciklama}
    kirintilar={[{ ad: 'İletişim', href: '/iletisim' }]}
  />

  <section class="bolum bg-mist">
    <div class="kapsayici">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
        <!-- Form -->
        <div class="lg:col-span-7">
          <IletisimFormu
            baslik={form.baslik}
            konu="AntCon web sitesi - iletişim formu"
            konular={form.konular}
            gonderButonu={form.gonderButonu}
            basariMesaji={form.basariMesaji}
          />
        </div>

        <!-- Yan sütun -->
        <aside class="space-y-6 lg:col-span-5">
          <!-- İletişim kanalları -->
          <div class="kart p-6">
            <h2 class="font-display text-lg font-bold text-blue-deep">{metinler.kanallarBasligi}</h2>
            <ul class="mt-5 space-y-4">
              {
                KANALLAR.map((kanal) => (
                  <li>
                    <a
                      href={kanal.href}
                      class="group flex items-start gap-3 rounded-lg p-2 -m-2 transition-colors hover:bg-mist"
                    >
                      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-main-orange/12 text-orange-deep">
                        <Ikon ad={kanal.ikon} sinif="w-5 h-5" />
                      </span>
                      <span>
                        <span class="block text-xs font-semibold tracking-wide text-ink-soft uppercase">
                          {kanal.baslik}
                        </span>
                        <span class="block font-semibold text-blue-deep group-hover:text-orange-deep">
                          {kanal.deger}
                        </span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Etkinlik yeri -->
          <div class="kart p-6">
            <h2 class="font-display text-lg font-bold text-blue-deep">{mekan.baslik}</h2>

            {
              mekanBelli ? (
                <>
                  <address class="mt-4 space-y-1 text-sm not-italic text-ink-soft">
                    <strong class="block text-base text-blue-deep">{ETKINLIK.mekan.ad}</strong>
                    {ETKINLIK.mekan.adres && <span class="block">{ETKINLIK.mekan.adres}</span>}
                    <span class="block">
                      {[ETKINLIK.mekan.postaKodu, ETKINLIK.mekan.ilce].filter(Boolean).join(' ')}
                      {ETKINLIK.mekan.ilce ? ' / ' : ''}
                      {ETKINLIK.mekan.sehir}
                    </span>
                  </address>
                  <p class="mt-4 flex items-center gap-2 text-sm text-ink-soft">
                    <Ikon ad="takvim" sinif="w-4 h-4 text-orange-deep" />
                    {ETKINLIK.tarihMetni}
                    {ETKINLIK.saatMetni && ` · ${ETKINLIK.saatMetni}`}
                  </p>
                  <a
                    href={ETKINLIK.mekan.haritaLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-cizgi btn-kucuk mt-5 w-full"
                  >
                    <Ikon ad="konum" sinif="w-4 h-4" />
                    {mekan.yolTarifiButonu}
                  </a>
                </>
              ) : (
                <>
                  <p class="mt-4 text-sm leading-relaxed text-ink-soft">
                    <strong class="block text-base text-blue-deep">{mekan.belirsizBaslik}</strong>
                    {mekan.belirsizMetin}
                  </p>
                  <p class="mt-4 flex items-center gap-2 text-sm text-ink-soft">
                    <Ikon ad="takvim" sinif="w-4 h-4 text-orange-deep" />
                    {ETKINLIK.tarihMetni}
                  </p>
                  <a
                    href={`/gecmis-etkinlikler/${SON_ETKINLIK_YILI}`}
                    class="btn btn-cizgi btn-kucuk mt-5 w-full"
                  >
                    {mekan.arsivButonu}
                  </a>
                </>
              )
            }
          </div>

          <!-- Sosyal medya -->
          {
            SOSYAL.length > 0 && (
              <div class="kart p-6">
                <h2 class="font-display text-lg font-bold text-blue-deep">{sosyal.baslik}</h2>
                <p class="mt-2 text-sm text-ink-soft">{sosyal.metin}</p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {SOSYAL.map((hesap) => (
                    <li>
                      <a
                        href={hesap.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-mist text-blue-deep transition-colors hover:bg-orange-deep hover:text-white"
                        aria-label={`AntCon ${hesap.ad} (yeni sekmede açılır)`}
                      >
                        <Ikon ad={hesap.ikon} sinif="w-5 h-5" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>
    </div>
  </section>

  <!-- Harita - yalnızca mekân kesinleştiğinde -->
  {
    mekanBelli && (
      <section class="bg-white pb-16" aria-labelledby="harita-baslik">
        <div class="kapsayici">
          <h2 id="harita-baslik" class="sr-yalniz">Etkinlik alanının haritadaki konumu</h2>
          <div class="overflow-hidden rounded-2xl border border-line shadow-card">
            <iframe
              src={ETKINLIK.mekan.haritaEmbed}
              title={`${ETKINLIK.mekan.ad} konumu - Google Haritalar`}
              width="100%"
              height="450"
              style="border:0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
              class="block h-[380px] w-full md:h-[450px]"
            />
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
