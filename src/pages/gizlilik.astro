---
import BaseLayout from '@layouts/BaseLayout.astro';
import SayfaBasligi from '@components/SayfaBasligi.astro';
import { kirintiSemasi } from '@lib/schema';
import { sayfaMetinleri, sayfaGovdesi } from '@lib/sayfa';

const metinler = await sayfaMetinleri('gizlilikSayfasi');
const govde = await sayfaGovdesi('gizlilikSayfasi');
---

<BaseLayout
  baslik={metinler.baslik}
  aciklama={metinler.seoAciklama}
  yapilandirilmisVeri={[kirintiSemasi([{ ad: 'Gizlilik', href: '/gizlilik' }])]}
  yapiskanCta={false}
>
  <SayfaBasligi
    etiket={metinler.etiket}
    baslik={metinler.baslik}
    aciklama={metinler.aciklama}
    kirintilar={[{ ad: 'Gizlilik', href: '/gizlilik' }]}
  />

  <section class="bolum bg-white">
    <div class="kapsayici">
      <div class="metin-akisi mx-auto max-w-3xl">
        {
          metinler.uyari && (
            <p class="rounded-lg border border-secondary-orange bg-secondary-orange/10 p-4 text-sm text-orange-darker">
              <strong>Not:</strong> {metinler.uyari}
            </p>
          )
        }
        <Fragment set:html={govde} />
      </div>
    </div>
  </section>
</BaseLayout>
